class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class DLL:
    def __init__(self):
        self.start = None

    def insert_end(self, data):
        n = Node(data)
        if self.start is None:
            self.start = n
            return
        temp = self.start
        while temp.next:
            temp = temp.next
        temp.next = n
        n.prev = temp

    def display_forward(self):
        temp = self.start
        print("Forward: ", end="")
        while temp:
            print(temp.data, end=" ")
            last = temp  # Save last node for backward print
            temp = temp.next
        print()

    def display_backward(self):
        temp = self.start
        while temp and temp.next:
            temp = temp.next  # Go to last node
        print("Backward: ", end="")
        while temp:
            print(temp.data, end=" ")
            temp = temp.prev
        print()

dll = DLL()
for val in [10, 20, 30, 40, 50]:
    dll.insert_end(val)

dll.display_forward()
dll.display_backward()
